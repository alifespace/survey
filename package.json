{
  "name": "cloudflare-survey",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@12.4.1",
  "type": "module",
  "scripts": {
    "dev": "WRANGLER_LOG_PATH=.wrangler/wrangler.log wrangler dev --local-protocol https",
    "check": "WRANGLER_LOG_PATH=.wrangler/wrangler.log wrangler deploy --dry-run --outdir .wrangler/dry-run",
    "test": "node --test"
  },
  "devDependencies": {
    "wrangler": "^4.149.0"
  }
}
